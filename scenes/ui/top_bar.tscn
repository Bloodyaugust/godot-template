[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/TopBar.cs" id="1_topbar"]

[node name="TopBar" type="PanelContainer"]
script = ExtResource("1_topbar")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 8

[node name="Row" type="HBoxContainer" parent="Margin"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "Title"

[node name="MenuButton" type="Button" parent="Margin/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(88, 0)
layout_mode = 2
text = "Menu"
