# Godot 4+ specific ignores
.godot/
/android/

# Local Godot docs (see CLAUDE.md). The tracked .gdignore keeps the editor from importing
# the thousands of images inside as game assets, even before the docs are downloaded.
docs/*
!docs/.gdignore

# Local tooling
*.csproj.lscache

# xUnit test project build output (tests/unit)
tests/unit/bin/
tests/unit/obj/

# Claude Code per-user overrides (project allowlist lives in .claude/settings.json and is checked in)
.claude/settings.local.json

# Export output (.github/workflows/publish-itch.yml and local godot-mono --export-release runs).
# The tracked .gdignore hides the dir from Godot's scanner — without it the exporter
# packs earlier exports' loose resource-typed files (e.g. deps.json) into later pcks.
build/*
!build/.gdignore

# Scratch space for local files (screenshots, notes). The tracked .gdignore hides it from
# Godot's scanner so nothing dropped here gets imported as a game asset.
tmp/*
!tmp/.gdignore
